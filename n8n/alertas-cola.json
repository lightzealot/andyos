          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        224,
        0
      ],
      "name": "Avisar por Telegram",
      "credentials": {
        "telegramApi": {
          "id": "REEMPLAZAR",
          "name": "Telegram AndyOS"
        }
      }
    }
  ],
  "connections": {
    "Alerta de AndyOS": {
      "main": [
        [
          {
            "node": "Avisar por Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
