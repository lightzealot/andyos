{
  "name": "AndyOS - Inbox desde Telegram",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {
          "chatIds": "REEMPLAZAR_CON_TU_CHAT_ID"
        }
      },
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.5,
      "position": [
        0,
        200
      ],
      "name": "Telegram Trigger",
      "webhookId": "6f0f4b1e-3c55-4f6e-9a4e-a1d0c2b7e001",
      "credentials": {
        "telegramApi": {
          "id": "REEMPLAZAR",
          "name": "Telegram AndyOS"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.message.text }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        240,
        200
      ],
      "name": "Trae texto"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.andresgomez.net/webhooks/inbox",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { text: $json.message.text, source: 'telegram', source_id: $json.message.chat.id + ':' + $json.message.message_id } }}",
        "options": {
          "timeout": 10000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        480,
        120
      ],
      "name": "Guardar en AndyOS",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "AndyOS Inbox Secret"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        720,
        120
      ],
      "name": "Guardada"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.duplicate ? 'Ya la tenia guardada.' : 'Idea guardada: ' + $json.title }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        960,
        40
      ],
      "name": "Responder OK",
      "credentials": {
        "telegramApi": {
          "id": "REEMPLAZAR",
          "name": "Telegram AndyOS"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "No pude guardar la idea en AndyOS. Reintentalo mas tarde.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        960,
        220
      ],
      "name": "Responder error",
      "credentials": {
        "telegramApi": {
          "id": "REEMPLAZAR",
          "name": "Telegram AndyOS"
        }
      }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "Por ahora solo guardo mensajes de texto.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        480,
        320
      ],
      "name": "Responder sin texto",
      "credentials": {
        "telegramApi": {
          "id": "REEMPLAZAR",
          "name": "Telegram AndyOS"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Trae texto",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trae texto": {
      "main": [
        [
          {
            "node": "Guardar en AndyOS",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Responder sin texto",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Guardar en AndyOS": {
      "main": [
        [
          {
            "node": "Guardada",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Guardada": {
      "main": [
        [
          {
            "node": "Responder OK",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Responder error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}