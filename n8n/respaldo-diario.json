{
  "name": "AndyOS - Respaldo diario",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 3,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "name": "Cada dia 03:00"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.andresgomez.store/webhooks/backup",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        224,
        0
      ],
      "name": "Descargar respaldo de AndyOS",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "AndyOS Backup Secret"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "inputDataFieldName": "data",
        "name": "={{ 'andyos-' + $now.toFormat('yyyy-MM-dd') + '.db.gz' }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "list",
          "value": "root",
          "cachedResultName": "/ (Root folder)"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        448,
        0
      ],
      "name": "Subir a Google Drive",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "REEMPLAZAR",
          "name": "Google Drive account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "REEMPLAZAR_CON_TU_CHAT_ID",
        "text": "ALERTA: fallo el respaldo diario de AndyOS. Revisa la ejecucion en n8n; hoy no hay copia nueva.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        672,
        0
      ],
      "name": "Avisar fallo del respaldo",
      "credentials": {
        "telegramApi": {
          "id": "REEMPLAZAR",
          "name": "Telegram AndyOS"
        }
      }
    }
  ],
  "connections": {
    "Cada dia 03:00": {
      "main": [
        [
          {
            "node": "Descargar respaldo de AndyOS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Descargar respaldo de AndyOS": {
      "main": [
        [
          {
            "node": "Subir a Google Drive",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Avisar fallo del respaldo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Subir a Google Drive": {
      "main": [
        [],
        [
          {
            "node": "Avisar fallo del respaldo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}