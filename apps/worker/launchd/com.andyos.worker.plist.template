<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.andyos.worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>@NODE@</string>
    <string>--env-file=@ENV_FILE@</string>
    <string>--import</string>
    <string>tsx</string>
    <string>apps/worker/src/index.ts</string>
  </array>
  <key>WorkingDirectory</key><string>@REPO@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>@PATH@</string>
    <key>HOME</key><string>@HOME@</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>@HOME@/.andyos-worker/logs/worker.log</string>
  <key>StandardErrorPath</key><string>@HOME@/.andyos-worker/logs/worker.log</string>
</dict>
</plist>
